#HOSPITAL CONTROLLER

public without sharing class HospitalController {

    @AuraEnabled(cacheable=true)
    public static List<Hospital__c> getHospitals(){

        return [

            SELECT
                Id,
                Hospital_Name__c,
                Location__c,
                Contact_Number__c,
                Email__c

            FROM Hospital__c
        ];
    }
}


